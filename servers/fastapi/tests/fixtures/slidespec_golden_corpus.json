    "name": "organization-map-handoff",
    "html": "<!doctype html><html data-qid-ignore><head><meta charset=\"utf-8\"><style>*{box-sizing:border-box}html,body{margin:0;width:1280px;height:720px}body{overflow:hidden;background:#f8fafc;font-family:Arial,sans-serif}.slide{position:relative;width:1280px;height:720px;padding:44px;display:grid;grid-template-columns:repeat(3,1fr);gap:18px;background:#f8fafc}.title{position:absolute;left:56px;top:40px;width:1020px;height:50px;margin:0;font-size:34px;line-height:44px;color:#0f2942}.lead{position:absolute;left:500px;top:120px;width:280px;height:84px;padding:18px;border-radius:14px;background:#1d4ed8;color:white;text-align:center;font-size:21px}.connector{position:absolute;top:204px;height:48px;width:2px;background:#93c5fd}.c1{left:276px}.c2{left:640px}.c3{left:1004px}.team{position:absolute;top:272px;width:300px;height:250px;padding:22px;border-radius:16px;background:white;border:1px solid #dce7f2;color:#18324d}.t1{left:126px}.t2{left:490px}.t3{left:854px}.team h2{margin:0 0 12px;font-size:23px}.team p{margin:0;font-size:17px;line-height:27px}</style></head><body data-qid-ignore><main class=\"slide\" data-qid=\"org-grid\" data-allow-overlap><h1 class=\"title\" data-qid=\"org-title\">Operating model handoff map</h1><section class=\"lead\" data-qid=\"org-lead\">Program lead</section><i class=\"connector c1\" data-qid=\"org-connector-1\"></i><i class=\"connector c2\" data-qid=\"org-connector-2\"></i><i class=\"connector c3\" data-qid=\"org-connector-3\"></i><article class=\"team t1\" data-qid=\"org-team-discover\"><h2 data-qid=\"org-discover-title\">Discover</h2><p data-qid=\"org-discover-copy\">Research intake and evidence capture.</p></article><article class=\"team t2\" data-qid=\"org-team-build\"><h2 data-qid=\"org-build-title\">Build</h2><p data-qid=\"org-build-copy\">Prototype, validate, and document decisions.</p></article><article class=\"team t3\" data-qid=\"org-team-operate\"><h2 data-qid=\"org-operate-title\">Operate</h2><p data-qid=\"org-operate-copy\">Publish, observe, and improve safely.</p></article></main></body></html>",
