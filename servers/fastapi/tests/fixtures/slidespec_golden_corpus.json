  {
    "name": "complex-image-focal-card",
    "html": "<!doctype html><html data-qid-ignore><head><meta charset=\"utf-8\"><style>*{box-sizing:border-box}html,body{margin:0;width:1280px;height:720px}body{overflow:hidden;background:#121826;font-family:Arial,sans-serif}.slide{position:relative;width:1280px;height:720px;background:linear-gradient(120deg,#121826,#1f3a5f);color:white}.title{position:absolute;left:70px;top:72px;width:510px;height:120px;margin:0;font-size:47px;line-height:58px}.copy{position:absolute;left:72px;top:240px;width:460px;height:120px;font-size:20px;line-height:31px;color:#d7e8f7}.frame{position:absolute;left:650px;top:66px;width:500px;height:570px;border-radius:32px;overflow:hidden;transform:rotate(-2deg);filter:drop-shadow(0 20px 28px rgba(0,0,0,.35));background:#0b2037}.hero{width:100%;height:100%;object-fit:cover;object-position:68% 34%;clip-path:polygon(0 0,100% 0,100% 88%,82% 100%,0 100%)}.badge{position:absolute;left:72px;top:446px;width:360px;height:66px;padding:18px;border-radius:33px;background:rgba(45,212,191,.18);border:1px solid #5eead4;color:#dffefa;font-size:17px}</style></head><body data-qid-ignore><section class=\"slide\" data-qid=\"focal-root\" data-allow-overlap><h1 class=\"title\" data-qid=\"focal-title\">Field imagery with a protected focal region</h1><p class=\"copy\" data-qid=\"focal-copy\">The image is synthetic and non-identifying; crop position, mask, filter, and transform exercise Chrome projection measurement.</p><div class=\"frame\" data-qid=\"focal-frame\"><img class=\"hero\" data-qid=\"focal-image\" alt=\"abstract blue geometry\" src=\"data:image/gif;base64,R0lGODlhAQABAIAAAABmmf///ywAAAAAAQABAAACAUwAOw==\"></div><div class=\"badge\" data-qid=\"focal-badge\">SAFE FOCAL AREA · 68% / 34%</div></section></body></html>",
