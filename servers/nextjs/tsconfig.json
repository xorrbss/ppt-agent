{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts",
    ".next-workspace-e2e/types/**/*.ts",
    ".next-workspace-e2e/dev/types/**/*.ts",
    ".next-template-v2-fidelity-template-v2-fidelity-QVp8l0/types/**/*.ts",
    ".next-template-v2-fidelity-template-v2-fidelity-QVp8l0/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.cy.ts",
    "**/*.cy.tsx"
  ]
}
