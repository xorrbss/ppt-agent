{
  "name": "presenton",
  "version": "1.0.0",
  "presentationExportVersion": "v0.4.8",
  "type": "module",
  "description": "Open-source AI presentation generator",
  "scripts": {
    "generate:brand-icons": "node scripts/generate-brand-icons.mjs",
    "generate:settings-registry": "node scripts/sync-settings-registry.mjs",
    "generate:provider-registry": "node scripts/generate-provider-registry.mjs",
    "generate:release-sbom": "node scripts/generate-release-sbom.mjs",
    "check:release-sbom": "node scripts/generate-release-sbom.mjs --check",
    "generate:notice": "uv run --directory servers/fastapi python ../../scripts/rebuild_notice_all.py",
    "check:notice": "uv run --directory servers/fastapi python ../../scripts/rebuild_notice_all.py --check",
    "check:provider-registry": "node scripts/generate-provider-registry.mjs --check",
    "test:provider-registry": "node scripts/generate-provider-registry.mjs --check && node --test scripts/provider-registry.test.mjs",
    "test:settings-registry": "node scripts/sync-settings-registry.mjs --check-only && node --test scripts/settings-registry.test.mjs",
    "sync:presentation-export": "node scripts/sync-presentation-export.cjs",
    "sync:presentation-export:force": "node scripts/sync-presentation-export.cjs --force",
    "check:presentation-export": "node scripts/sync-presentation-export.cjs --check-only",
    "test:presentation-export-sync": "node --test scripts/sync-presentation-export.test.cjs",
    "test:chat-first-deployment-config": "node scripts/check-chat-first-deployment-config.mjs",
    "check:structural-layering": "node scripts/check-structural-layering.mjs",
    "test:next-ci": "npm run test:chat-first-deployment-config && npm run test:settings-registry && npm run check:provider-registry && npm run check:release-sbom && npm run check:notice && npm run check:structural-layering && node --test scripts/ppt-agent.test.mjs scripts/presenton-local-proxy.test.mjs scripts/release-license-policy.test.mjs scripts/required-ci-contract.test.mjs scripts/multi-process-compose-contract.test.mjs scripts/verify-upstream-byte-parity.test.mjs scripts/benchmarks/authored-infographic/run-benchmark.test.mjs scripts/generation-benchmark.test.mjs scripts/check-structural-layering.test.mjs && npm --prefix servers/nextjs run test:ci-node",
    "check:upstream-byte-parity": "node scripts/verify-upstream-byte-parity.mjs --tree HEAD",
    "check:upstream-byte-parity:working-tree": "node scripts/verify-upstream-byte-parity.mjs --working-tree",
    "test:upstream-byte-parity": "node --test scripts/verify-upstream-byte-parity.test.mjs",
    "test:workspace-e2e": "npm --prefix servers/nextjs run test:workspace-e2e",
    "dev:authored-vnext:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-authored-vnext-dev.ps1",
    "test:local": "node scripts/test-local.mjs"
  },
  "dependencies": {
    "@llamaindex/liteparse": "^1.5.2",
    "sharp": "0.35.3",
    "tesseract.js": "^7.0.0"
  },
  "overrides": {
    "axios": "1.18.1",
    "form-data": "4.0.6",
    "sharp": "0.35.3"
  }
}
