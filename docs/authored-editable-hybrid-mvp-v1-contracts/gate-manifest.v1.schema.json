{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:presenton:authored-editable-hybrid:gate-manifest:v1",
  "type": "object",
  "required": ["schemaVersion", "profileId", "authorityDomain", "manifestDigest", "noSkip"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^authored-editable-hybrid-" },
    "profileId": { "const": "authored-editable-hybrid-ko-en-basic-v1" },
    "authorityDomain": { "enum": ["actual_product_capability_probe", "structural_test", "actual_product"] },
    "manifestDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "noSkip": { "const": true },
    "requiredCaseCount": { "type": "integer", "minimum": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["ordinal", "caseId"] } },
    "requiredArtifactCount": { "type": "integer", "minimum": 1 },
    "requiredArtifactIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": true
}
