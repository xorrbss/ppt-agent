{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:presenton:authored:semantic-validation-receipt-ref:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactId", "versionId", "mediaType", "byteLength", "sha256", "receiptSchemaVersion", "issuerId", "signerKeyId", "signatureAlgorithm", "signatureBase64", "issuedAt", "expiresAt", "nonce", "subjectManifestDigest", "subjectResultCoreDigest", "semanticValidatorContractDigest", "receiptDigest"],
  "properties": {
    "artifactId": { "type": "string", "minLength": 1 }, "versionId": { "type": "string", "minLength": 1 }, "mediaType": { "const": "application/json" }, "byteLength": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/digest" },
    "receiptSchemaVersion": { "const": "authored-semantic-validation-receipt/v1" },
    "issuerId": { "type": "string", "minLength": 1 }, "signerKeyId": { "type": "string", "minLength": 1 }, "signatureAlgorithm": { "const": "Ed25519" }, "signatureBase64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" },
    "issuedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }, "expiresAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }, "nonce": { "type": "string", "minLength": 16 },
    "subjectManifestDigest": { "$ref": "#/$defs/digest" }, "subjectResultCoreDigest": { "$ref": "#/$defs/digest" }, "semanticValidatorContractDigest": { "$ref": "#/$defs/digest" }, "receiptDigest": { "$ref": "#/$defs/digest" }
  },
  "description": "This object is an outer reference, not the receipt payload. artifactId/versionId/mediaType/byteLength/sha256 exist only in this outer result reference. The referenced immutable receipt payload starts at receiptSchemaVersion and MUST NOT contain its own artifact identity or sha256. receiptDigest is canonical JSON v2 over that payload excluding $.receiptDigest and $.signatureBase64; signatureBase64 is Ed25519 over receiptDigest. The enclosing result core excludes the outer receipt ref; the final result-set digest includes it."
}
