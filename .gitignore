# Keep the repository-owned artifact-to-Authored workflow discoverable by Codex.
!.agents/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/build-authored-style/

# Build-time layout-schema artifact + its transient esbuild bundle
# (generated by servers/nextjs/scripts/generate-layout-schemas.mjs on prebuild)
servers/nextjs/app/presentation-templates/layouts.generated.json
servers/nextjs/.layout-schemas-gen.mjs

# presenton-export runtime (downloaded via scripts/sync-presentation-export.cjs or Docker build)
presentation-export/
.cache/presentation-export/
servers/fastapi/build/
servers/fastapi/dist/
servers/fastapi/fastembed_cache/
servers/fastapi/*.egg-info/
.codex/

# --- Local dev/test artifacts (Windows local run; not part of the project) ---
/.cache/
/.run_app_data/
/.run_tmp/
/.heartbeat

# --- Regenerable caches/build artifacts (slimmed from history 2026-06) ---
servers/fastapi/fastembed_cache/
servers/fastapi/chroma/
servers/fastapi/build/
servers/fastapi/dist/
electron/servers/
servers/nextjs/cypress/screenshots/
servers/nextjs/cypress/videos/
servers/nextjs/cypress/downloads/

# Scratch runtime for local end-to-end runs (browser profiles, dev-server logs,
# temp exports). Regenerated on demand and hundreds of MB when populated.
.test-runtime/
/.server-logs-main/
/.tmp/
servers/fastapi/.codex-backend.*.log
servers/fastapi/backend-template-card.*.log
servers/fastapi/.pytest-*/
servers/nextjs/test-results/
electron/kor.traineddata

# Release candidates are generated and quarantined by CI. Only signed release
# manifests deliberately added through the release process belong in Git.
electron/dist/
test-artifacts/

# Disposable packaged renderer probes are rebuilt from the checked-in probe,
# policy, provenance, and compact JSON observations. Keep the hundreds-of-MB
# Electron runtime out of Git while retaining its final evidence receipts.
contracts/authored-renderer/evidence/*-electron-probe-package/
contracts/authored-renderer/evidence/*-electron-probe-package-source/
contracts/authored-renderer/evidence/*.tmp-*
contracts/authored-renderer/evidence/*/probe-stdout.txt
contracts/authored-renderer/evidence/*/probe-stderr.txt

# Prototype and compatibility experiments keep their reproducible source,
# manifests, and checked-in vendor boundary, but not generated Office files,
# LibreOffice profiles, probe captures, or intermediate run receipts.
docs/experiments/authored-vnext/**/agent-probe/
docs/experiments/authored-vnext/**/artifacts/
docs/experiments/authored-vnext/**/output/
docs/experiments/authored-vnext/**/results/
docs/experiments/authored-vnext/**/runs/
docs/experiments/authored-vnext/**/tmp/

# This project is npm-based (package-lock.json). Block stray pnpm artifacts left
# by a one-off `pnpm install` so they cannot cause dual-lockfile drift.
pnpm-lock.yaml
pnpm-workspace.yaml

# stdout/stderr of locally launched backend, frontend and proxy processes. These
# carry request paths and presentation ids from real decks.
.local-runtime-logs/
