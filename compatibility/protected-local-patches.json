        {
          "path": "presentation-export/.installed-version",
          "requiredContains": ["v0.4.2"]
        }
      ]
    },
    {
      "id": "export-security-boundaries",
      "category": "security",
      "rationale": "Protect loopback-only render URLs, path containment, finite process deadlines, and cross-platform process-tree termination.",
      "files": [
        {
          "path": "servers/nextjs/lib/export-render-url.ts",
          "requiredContains": ["http://127.0.0.1:"]
        },
        {
          "path": "servers/nextjs/lib/export-process-supervisor.ts",
