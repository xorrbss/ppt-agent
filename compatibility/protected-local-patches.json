{
  "schemaVersion": 1,
  "patches": [
    {
      "id": "authored-hybrid-export",
      "category": "authored-hybrid",
      "rationale": "Preserve editable native layers, fidelity fallback, output containment, bounded fetches, and network-isolation coverage during upstream rebases.",
      "files": [
        {
          "path": "servers/nextjs/lib/authored-hybrid/export.ts",
          "requiredContains": [
            "HYBRID_CACHE_VERSION",
            "resolveSafeFidelityPptx",
            "fs.realpath",
            "runAuthoredHybridPresentationExport"
          ]
        },
        {
          "path": "servers/nextjs/lib/authored-hybrid/security.test.mjs",
          "requiredContains": [
            "Chrome blocks network requests",
            "presentation response reads are byte-bounded"
          ]
        },
        {
          "path": "servers/nextjs/app/api/export-presentation/route.ts",
          "requiredContains": [
            "runAuthoredHybridPresentationExport",
            "path.relative(exportsDirectory, outPath)",
            "path.isAbsolute(relativePath)"
          ]
        }
      ]
    },
    {
      "id": "windows-export-runtime-sync",
      "category": "windows-sync",
      "rationale": "Keep the pinned exporter runtime reproducible and executable on Windows as well as Linux.",
      "files": [
        {
          "path": "scripts/sync-presentation-export.cjs",
          "requiredContains": [
            "--check-only",
            "EXPORT_RUNTIME_VERSION",
            "process.platform === \"win32\"",
            "powershell",
            ".installed-version"
          ]
        },
        {
          "path": "servers/nextjs/lib/run-bundled-presentation-export.ts",
          "requiredContains": [
            "process.platform === \"win32\"",
            "path.isAbsolute(pathValue)",
            "spawn(process.execPath"
          ]
        },
        {
          "path": "presentation-export/.installed-version",
          "requiredContains": ["v0.4.2"]
        }
      ]
    },
    {
      "id": "export-security-boundaries",
      "category": "security",
      "rationale": "Protect loopback-only render URLs, path containment, finite process deadlines, and cross-platform process-tree termination.",
      "files": [
        {
          "path": "servers/nextjs/lib/export-render-url.ts",
          "requiredContains": ["http://127.0.0.1:"]
        },
        {
          "path": "servers/nextjs/lib/export-process-supervisor.ts",
          "requiredContains": [
            "DEFAULT_EXPORT_DEADLINE_MS",
            "presentation_export_timeout",
            "taskkill.exe",
            "SIGKILL"
          ]
        },
        {
          "path": "servers/nextjs/lib/authored-hybrid/export.ts",
          "requiredContains": [
            "resolved.startsWith(exportsDirectory + path.sep)",
            "mode: 0o600"
          ]
        }
      ]
    },
    {
      "id": "template-v2-delete-integrity",
      "category": "data-integrity",
      "rationale": "Prevent broad parent cascades from hiding divergent Template V2 ownership while retaining presentation-owned cleanup and durable PPTX import audit records.",
      "files": [
        {
          "path": "servers/fastapi/alembic/versions/0a1b2c3d4e5f_harden_template_v2_delete_cascade.py",
          "requiredContains": [
            "LOCAL_STATE_PRESENTATION_FK",
            "_require_sidecar_ownership_ready",
            "connection.dialect.name == \"mysql\"",
            "replacement=\"RESTRICT\"",
            "replacement=\"CASCADE\""
          ]
        },
        {
          "path": "servers/fastapi/services/presentation_deletion_service.py",
          "requiredContains": [
            "class PresentationDeletionService",
            "canonical_ids != sidecar_ids",
            "delete(TemplateV2)",
            "PresentationDeleteConflictError"
          ]
        },
        {
          "path": "servers/fastapi/api/v1/ppt/endpoints/presentation_crud.py",
          "requiredContains": [
            "PresentationDeletionService(sql_session).delete(presentation)",
            "presentation_delete_dependency_conflict"
          ]
        },
        {
          "path": "servers/fastapi/template_v2_schema_contract.py",
          "requiredContains": [
            "TEMPLATE_V2_PRESENTATION_DELETE_POLICY = \"explicit-child-first\"",
            "TEMPLATE_V2_PRESENTATION_FK_DELETE_ACTIONS"
          ]
        },
        {
          "path": "servers/fastapi/tests/unit/test_presentation_delete_safety.py",
          "requiredContains": [
            "test_delete_api_removes_owned_template_and_preserves_import_audit",
            "test_delete_api_fails_closed_when_sidecar_ownership_is_missing",
            "test_delete_api_rolls_back_all_mutations_on_dependency_conflict"
          ]
        }
      ]
    }
  ]
}
