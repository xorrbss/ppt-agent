{
  "schemaVersion": 1,
  "remoteIntakeReview": {
    "policy": "compatibility/upstream-intake-policy.json",
    "disposition": "manual-reconciliation-required",
    "rule": "An exact upstream changed-path overlap is risk evidence, not proof that a local patch is broken. The local verifier and behavioral tests remain authoritative."
  },
  "patches": [
    {
      "id": "authored-hybrid-export",
      "category": "authored-hybrid",
      "rationale": "Preserve editable native layers, fidelity fallback, output containment, bounded fetches, and network-isolation coverage during upstream rebases.",
      "files": [
        {
          "path": "servers/nextjs/lib/authored-hybrid/export.ts",
          "requiredContains": [
            "HYBRID_CACHE_VERSION",
            "resolveSafeFidelityPptx",
            "fs.realpath",
            "runAuthoredHybridPresentationExport"
          ]
        },
        {
          "path": "servers/nextjs/lib/authored-hybrid/security.test.mjs",
          "requiredContains": [
            "Chrome blocks network requests",
            "presentation response reads are byte-bounded"
          ]
        },
        {
          "path": "servers/nextjs/app/api/export-presentation/route.ts",
          "requiredContains": [
            "runAuthoredHybridPresentationExport",
            "path.relative(exportsDirectory, outPath)",
            "path.isAbsolute(relativePath)"
          ]
        }
      ]
    },
    {
      "id": "windows-export-runtime-sync",
      "category": "windows-sync",
      "rationale": "Keep the pinned exporter runtime reproducible and executable on Windows as well as Linux.",
      "files": [
