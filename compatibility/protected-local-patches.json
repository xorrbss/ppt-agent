            "TEMPLATE_V2_PRESENTATION_FK_DELETE_ACTIONS"
          ]
        },
        {
          "path": "servers/fastapi/tests/unit/test_presentation_delete_safety.py",
          "requiredContains": [
            "test_delete_api_removes_owned_template_and_preserves_import_audit",
            "test_delete_api_fails_closed_when_sidecar_ownership_is_missing",
            "test_delete_api_rolls_back_all_mutations_on_dependency_conflict",
            "test_delete_api_returns_retryable_503_and_rolls_back_on_sqlite_lock"
