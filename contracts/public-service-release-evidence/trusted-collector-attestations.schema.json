{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "public-service-trusted-collector-attestations/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "algorithm", "keyId", "reports"],
  "properties": {
    "schemaVersion": { "const": "public-service-trusted-collector-attestations/v1" },
    "algorithm": { "const": "ed25519" },
    "keyId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "reports": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceDigest", "signatureBase64"],
        "properties": {
          "sourceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "signatureBase64": { "type": "string", "minLength": 80, "maxLength": 128 }
        }
      }
    }
  }
}
