{"$defs": {"AuthoredCompositionPin": {"additionalProperties": false, "description": "Sole content-addressed composition used by every generation consumer.\n\nThe authored style and company standard remain independently addressable\nthrough the two typed projections below, while this pin and its digest are\nthe only durable preview/checkpoint/publication/export authority.", "properties": {"authoredTemplate": {"anyOf": [{"$ref": "#/$defs/AuthoredTemplateSnapshot"}, {"type": "null"}], "default": null}, "bodyVisual": {"$ref": "#/$defs/BodyVisualSnapshot"}, "consistencyPolicy": {"anyOf": [{"$ref": "#/$defs/ConsistencyPolicySnapshot"}, {"type": "null"}], "default": null}, "digest": {"pattern": "^sha256:[0-9a-f]{64}$", "title": "Digest", "type": "string"}, "effectiveContractDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "title": "Effectivecontractdigest", "type": "string"}, "masterDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "title": "Masterdigest", "type": "string"}, "mergePolicyVersion": {"maxLength": 100, "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$", "title": "Mergepolicyversion", "type": "string"}, "schemaVersion": {"const": "authored-composition-pin/v1", "default": "authored-composition-pin/v1", "title": "Schemaversion", "type": "string"}, "styleDigest": {"anyOf": [{"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}, {"type": "null"}], "default": null, "title": "Styledigest"}, "styleId": {"anyOf": [{"maxLength": 200, "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$", "type": "string"}, {"type": "null"}], "default": null, "title": "Styleid"}}, "required": ["masterDigest", "mergePolicyVersion", "bodyVisual", "effectiveContractDigest", "digest"], "title": "AuthoredCompositionPin", "type": "object"}, "AuthoredTemplateSnapshot": {"additionalProperties": false, "description": "Retained authored-template compiler contract frozen at admission.", "properties": {"archetypes": {"items": {"type": "string"}, "maxItems": 32, "minItems": 1, "title": "Archetypes", 