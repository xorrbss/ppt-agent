": "string"}, {"type": "null"}], "default": null, "title": "Imagedirection"}, "panelBorderColor": {"pattern": "^#[0-9A-Fa-f]{6}$", "title": "Panelbordercolor", "type": "string"}, "panelEnabled": {"default": true, "title": "Panelenabled", "type": "boolean"}, "panelFill": {"pattern": "^#[0-9A-Fa-f]{6}$", "title": "Panelfill", "type": "string"}, "processAccent": {"pattern": "^#[0-9A-Fa-f]{6}$", "title": "Processaccent", "type": "string"}, "schemaVersion": {"const": "authored-body-visual/v1", "default": "authored-body-visual/v1", "title": "Schemaversion", "type": "string"}, "secondaryTextColor": {"pattern": "^#[0-9A-Fa-f]{6}$", "title": "Secondarytextcolor", "type": "string"}, "tableHeaderFill": {"pattern": "^#[0-9A-Fa-f]{6}$", "title": "Tableheaderfill", "type": "string"}, "textColor": {"pattern": "^#[0-9A-Fa-f]{6}$", "title": "Textcolor", "type": "string"}, "warning": {"pattern": "^#[0-9A-Fa-f]{6}$", "title": "Warning", "type": "string"}}, "required": ["accent", "panelFill", "textColor", "secondaryTextColor", "warning", "panelBorderColor", "chartPalette", "tableHeaderFill", "processAccent", "headingFont", "bodyFont"], "title": "BodyVisualSnapshot", "type": "object"}, "ConsistencyPolicySnapshot": {"additionalProperties": false, "description": "Content-addressed projection of company furniture and document rules.", "properties": {"contentRect": {"$ref": "#/$defs/Rect"}, "digest": {"pattern": "^sha256:[0-9a-f]{64}$", "title": "Digest", "type": "string"}, "metadata": {"$ref": "#/$defs/DeckMetadataSnapshot"}, "reservedZones": {"items": {"$ref": "#/$defs/ReservedZoneSnapshot"}, "maxItems": 4096, "title": "Reservedzones", "type": "array"}, "reviewRequiredElementIds": {"items": {"type": "string"}, "maxItems": 2048, "title": "Reviewrequiredelementids", "type": "array"}, "rolePolicies": {"items": {"$ref": "#/$defs/SlideRolePolicySnapshot"}, "maxItems": 4, "minItems": 4, "title": "Rolepolicies", "type": "array"}, "schemaVersion": {"const": "company-consistency-policy/v1", "default": "company-consistency-policy/v1", "title": "Schemaversion", "type": "string"}, "sourceMasterDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "title": "Sourcemasterdigest", "type": "string"}}, "required": ["sourceMasterDigest", "contentRect", "reservedZones", "rolePolicies", "digest"], "title": "ConsistencyPolicySnapshot", "type": "object"}, "DeckMetadataSnapshot": {"additionalProperties": false, "description": "Single authoritative RFP/document identity frozen at admission.", "properties": {"documentId": {"anyOf": [{"maxLength": 500, "type": "string"}, {"type": "null"}], "default": null, "title": "Documentid"}, "kind": {"default": "none", "enum": ["none", "rfp", "documentNumber"], "title": "Kind", "type": "string"}}, "title": "DeckMetadataSnapshot", "type": "object"}, "MasterDigestPin": {"additionalProperties": false, "properties": {"fontManifestDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "title": "Fontmanifestdigest", "type": "string"}, "layoutRegistryDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "title": "Layoutregistrydigest", "type": "string"}, "masterDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "title": "Masterdigest", "type": "string"}, "masterId": {"pattern": "^master:[a-z0-9][a-z0-9._-]*$", "title": "Masterid", "type": "string"}, "masterRevision": {"minimum": 1, "title": "Masterrevision", "type": "integer"}}, "required": ["masterId", "masterRevision", "masterDigest", "layoutRegistryDigest", "fontManifestDigest"], "title": "MasterDigestPin", "type": "object"}, "OutlineInput": {"additionalProperties": false, "properties": {"deckTitle": {"maxLength": 4000, "minLength": 1, "title": "Decktitle", "type": "string"}, "items": {"items": {"$ref": "#/$defs/OutlineItem"}, "maxItems": 500, "minItems": 1, "title": "Items", "type": "array"}, "schemaVersion": {"const": "authored-outline/v1", "default": "authored-outline/v1", "title": "Schemaversion", "type": "string"}, "sourceDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "title": "Sourcedigest", "type": "string"}}, "required": ["sourceDigest", "deckTitle", "items"], "title": "OutlineInput", "type": "object"}, "OutlineItem": {"additionalProperties": false, "properties": {"index": {"maximum": 499, "minimum": 0, "title": "Index", "type": "integer"}, "itemId": {"pattern": "^outline:[a-z0-9][a-z0-9._-]*$", "title": "Itemid", "type": "string"}, "roleHint": {"anyOf": [{"enum": ["cover", "section", "standard", "longTitle"], "type": "string"}, {"type": "null"}], "default": null, "title": "Rolehint"}, "summary": {"maxLength": 20000, "minLength": 1, "title": "Summary", "type": "string"}, "title": {"maxLength": 4000, "minLength": 1, "title": "Title", "type": "string"}}, "required": ["itemId", "index", "title", "summary"], "title": "OutlineItem", "type": "object"}, "PublicationFence": {"additionalProperties": false, "properties": {"expectedActiveRevisionDigest": {"anyOf": [{"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}, {"type": "null"}], "default": null, "title": "Expectedactiverevisiondigest"}, "expectedDeckRevision": {"minimum": 0, "title": "Expecteddeckrevision", "type": "integer"}}, "required": ["expectedDeckRevision"], "title": "PublicationFence", "type": "object"}, "Rect": {"additionalProperties": false, "properties": {"height": {"exclusiveMinimum": 0, "title": "Height", "type": "number"}, "width": {"exclusiveMinimum": 0, "title": "Width", "type": "number"}, "x": {"minimum": 0, "title": "X", "type": "number"}, "y": {"minimum": 0, "title": "Y", "type": "number"}}, "required": ["x", "y", "width", "height"], "title": "Rect", "type": "object"}, "ReferenceLayoutCanvasSnapshot": {"additionalProperties": false, "description": "Canvas frozen with the retained reference geometry.", "properties": {"height": {"exclusiveMinimum": 0, "maximum": 100000, "title": "Height", "type": "number"}, "width": {"exclusiveMinimum": 0, "maximum": 100000, "title": "Width", "type": "number"}}, "required": ["width", "height"], "title": "ReferenceLayoutCanvasSnapshot", "type": "object"}, "ReservedZoneSnapshot": {"additionalProperties": false, "description": "One company-owned area that authored content must never enter.", "properties": {"bounds": {"$ref": "#/$defs/Rect"}, "classification": {"enum": ["confirmed", "projected", "reviewRequired"], "title": "Classification", "type": "string"}, "id": {"maxLength": 240, "minLength": 1, "pattern": "^[a-z][a-z0-9._:-]*$", "title": "Id", "type": "string"}, "kind": {"enum": ["logo", "pageNumber", "header", "footer", "divider", "fixedText", "backgroundDecoration", "metadataPlaceholder", "reviewRequired"], "title": "Kind", "type": "string"}, "sourceElementId": {"anyOf": [{"maxLength": 240, "type": "string"}, {"type": "null"}], "default": null, "title": "Sourceelementid"}}, "required": ["id", "kind", "bounds", "classification"], "title": "ReservedZoneSnapshot", "type": "object"}, "ResolvedReferenceLayoutSnapshot": {"additionalProperties": false, "description": "Full retained-reference layout library persisted in the composition pin.\n\nLayout records deliberately stay canonical JSON objects: their shape vocabulary is\nversioned by ``schemaVersion`` and is consumed identically by the HTML and OOXML\ncompilers.  The outer envelope still validates identity, canvas, count, and digest,\nso a future layout vocabulary can be replayed without silently discarding fields.", "properties": {"canvas": {"$ref": "#/$defs/ReferenceLayoutCanvasSnapshot"}, "digest": {"pattern": "^sha256:[0-9a-f]{64}$", "title": "Digest", "type": "string"}, "layouts": {"items": {"additionalProperties": true, "type": "object"}, "maxItems": 128, "minItems": 1, "title": "Layouts", "type": "array"}, "retainedReferenceId": {"maxLength": 240, "minLength": 1, "title": "Retainedreferenceid", "type": "string"}, "schemaVersion": {"const": "retained-reference-layout/v1", "default": "retained-reference-layout/v1", "title": "Schemaversion", "type": "string"}, "sourceDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "title": "Sourcedigest", "type": "string"}}, "required": ["retainedReferenceId", "sourceDigest", "canvas", "layouts", "digest"], "title": "ResolvedReferenceLayoutSnapshot", "type": "object"}, "SceneAssetManifestEntry": {"additionalProperties": false, "properties": {"assetDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "title": "Assetdigest", "type": "string"}, "assetId": {"pattern": "^asset:[a-z0-9][a-z0-9._-]*$", "title": "Assetid", "type": "string"}, "mediaType": {"enum": ["image/png", "image/jpeg", "image/svg+xml", "image/webp"], "title": "Mediatype", "type": "string"}, "sizeBytes": {"exclusiveMinimum": 0, "maximum": 100000000, "title": "Sizebytes", "type": "integer"}, "storageReference": {"maxLength": 133334000, "minLength": 1, "title": "Storagereference", "type": "string"}}, "required": ["assetId", "assetDigest", "mediaType", "storageReference", "sizeBytes"], "title": "SceneAssetManifestEntry", "type": "object"}, "SceneDataManifestEntry": {"additionalProperties": false, "properties": {"dataDigest": {"pattern": "^sha256:[0-9a-f]{64}$", "title": "Datadigest", "type": "string"}, "dataId": {"pattern": "^data:[a-z0-9][a-z0-9._-]*$", "title": "Dataid", "type": "string"}, "kind": {"enum": ["table", "chart"], "title": "Kind", "type": "string"}, "payload": {"additionalProperties": true, "title": "Payload", "type": "object"}}, "required": ["dataId", "dataDigest", "kind", "payload"], "title": "SceneDataManifestEntry", "type": "object"}, "SlideRolePolicySnapshot": {"additionalProperties": false, "description": "Hidden company consistency rules; never a user-facing third selector.", "properties": {"bulletPolicy": {"enum": ["none", "preserve", "normalizeOneLevel"], "title": "Bulletpolicy", "type": "string"}, "contentRect": {"$ref": "#/$defs/Rect"}, "maxTitleLines": {"maximum": 4, "minimum": 1, "title": "Maxtitlelines", "type": "integer"}, "role": {"enum": ["cover", "section", "content", "closing"], "title": "Role", "type": "string"}, "showDocumentId": {"default": false, "title": "Showdocumentid", "type": "boolean"}, "titleAlignment": {"enum": ["left", "center", "right"], "title": "Titlealignment", "type": "string"}, "titleAnchor": {"$ref": "#/$defs/Rect"}}, "required": ["role", "titleAnchor", "contentRect", "maxTitleLines", "titleAlignment", "bulletPolicy"], "title": "SlideRolePolicySnapshot", "type": "object"}, "SlideSceneInput": {"additionalProperties": false, "description": "Digest-pinned structured source for one authored Scene slide.", "properties": {"outlineItemId": {"pattern": "^outline:[a-z0-9][a-z0-9._-]*$", "title": "Outlineitemid", "type": "string"}, "roleHint": {"enum": ["card", "process", "timeline", "comparison", "metric", "infographic", "image", "table", "chart"], "title": "Rolehint", "type": "string"}, "sourceData": {"anyOf": [{"additionalProperties": true, "type": "object"}, {"type": "null"}], "default": null, "title": "Sourcedata"}, "sourceImage": {"anyOf": [{"additionalProperties": true, "type": "object"}, {"type": "null"}], "default": null, "title": "Sourceimage"}}, "required": ["outlineItemId", "roleHint"], "title": "SlideSceneInput", "type": "object"}}, "$id": "urn:presenton:authored-vnext:generate-deck-request:v1", "$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"assetManifest": {"items": {"$ref": "#/$defs/SceneAssetManifestEntry"}, "maxItems": 500, "title": "Assetmanifest", "type": "array"}, "composition": {"anyOf": [{"$ref": "#/$defs/AuthoredCompositionPin"}, {"type": "null"}], "default": null}, "dataManifest": {"items": {"$ref": "#/$defs/SceneDataManifestEntry"}, "maxItems": 500, "title": "Datamanifest", "type": "array"}, "deckId": {"pattern": "^deck:[a-z0-9][a-z0-9._-]*$", "title": "Deckid", "type": "string"}, "master": {"$ref": "#/$defs/MasterDigestPin"}, "operationId": {"pattern": "^operation:[a-z0-9][a-z0-9._-]*$", "title": "Operationid", "type": "string"}, "outline": {"$ref": "#/$defs/OutlineInput"}, "publicationFence": {"$ref": "#/$defs/PublicationFence"}, "qualityPolicyVersion": {"maxLength": 100, "minLength": 1, "title": "Qualitypolicyversion", "type": "string"}, "schemaVersion": {"const": "generate-deck-request/v1", "default": "generate-deck-request/v1", "title": "Schemaversion", "type": "string"}, "slideSceneInputs": {"items": {"$ref": "#/$defs/SlideSceneInput"}, "maxItems": 500, "title": "Slidesceneinputs", "type": "array"}}, "required": ["operationId", "deckId", "master", "outline", "qualityPolicyVersion", "publicationFence"], "title": "GenerateDeckRequest", "type": "object", "x-pydantic-strict": true}
