{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presenton.local/contracts/authored-vnext/narrative-ir/v1/narrative-ir.schema.json",
  "title": "Narrative IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operationId", "title", "language", "slides", "sourceUnitOrder", "narrativeDigest"],
  "properties": {
    "schemaVersion": {"const": "narrative-ir/v1"},
    "operationId": {"type": "string", "format": "uuid"},
    "title": {"type": "string", "minLength": 1, "maxLength": 4000},
    "language": {"type": "string", "minLength": 2, "maxLength": 64},
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/slide"}
    },
    "sourceUnitOrder": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/sourceUnit"}
    },
    "narrativeDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$", "maxLength": 160},
    "sourceUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceIndex", "sourceUnitId"],
      "properties": {
        "sourceIndex": {"type": "integer", "minimum": 0, "maximum": 999},
        "sourceUnitId": {"$ref": "#/$defs/key"}
      }
    },
    "sourceOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceBindingId", "sourceContentDigest", "useMode", "required"],
      "properties": {
        "sourceBindingId": {"$ref": "#/$defs/key"},
        "sourceContentDigest": {"$ref": "#/$defs/digest"},
        "useMode": {"enum": ["verbatim", "structured-data", "meaning-preserving", "reference-only"]},
        "required": {"type": "boolean"}
      }
    },
    "datum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datumKey", "label", "value"],
      "properties": {
        "datumKey": {"$ref": "#/$defs/key"},
        "label": {"type": "string", "minLength": 1, "maxLength": 4000},
        "value": {"type": ["string", "number", "integer", "boolean"]},
        "unit": {"type": ["string", "null"], "maxLength": 80},
        "sourceBindingId": {"oneOf": [{"$ref": "#/$defs/key"}, {"type": "null"}]}
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slideKey", "sequenceIndex", "role", "keyMessage", "supportingPoints", "dataRepresentation", "data", "sourceOwnership", "frameSemantics", "density"],
      "properties": {
        "slideKey": {"$ref": "#/$defs/key"},
        "sequenceIndex": {"type": "integer", "minimum": 0, "maximum": 999},
        "role": {"$ref": "#/$defs/key"},
        "keyMessage": {"type": "string", "minLength": 1, "maxLength": 4000},
        "supportingPoints": {"type": "array", "maxItems": 24, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
        "dataRepresentation": {"enum": ["none", "metric", "table", "chart", "timeline", "process", "comparison", "image", "quote"]},
        "data": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/datum"}},
        "sourceOwnership": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/sourceOwnership"}},
        "frameSemantics": {"type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/key"}},
        "density": {"enum": ["sparse", "medium", "dense"]}
      }
    }
  }
}
