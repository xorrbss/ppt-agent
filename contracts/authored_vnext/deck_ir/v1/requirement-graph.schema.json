{
  "$defs": {
    "RequirementV1": {
      "additionalProperties": false,
      "properties": {
        "allowedSlideRoles": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Allowedslideroles",
          "type": "array"
        },
        "kind": {
          "enum": [
            "claim",
            "evidence",
            "source",
            "data",
            "action",
            "constraint",
            "derivedSuggestion"
          ],
          "title": "Kind",
          "type": "string"
        },
        "maximumOccurrences": {
          "maximum": 30,
          "minimum": 0,
          "title": "Maximumoccurrences",
          "type": "integer"
        },
        "minimumOccurrences": {
          "maximum": 30,
          "minimum": 0,
          "title": "Minimumoccurrences",
          "type": "integer"
        },
        "normalizedIntent": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Normalizedintent",
          "type": "string"
        },
        "priority": {
          "enum": [
            "required",
            "optional"
          ],
          "title": "Priority",
          "type": "string"
        },
        "requirementId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Requirementid",
          "type": "string"
        },
        "sourceBindingIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Sourcebindingids",
          "type": "array"
        }
      },
      "required": [
        "requirementId",
        "kind",
        "priority",
        "normalizedIntent",
        "minimumOccurrences",
        "maximumOccurrences"
      ],
      "title": "RequirementV1",
      "type": "object"
    }
  },
  "$id": "urn:presenton:authored-vnext:deck-ir:requirement-graph.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "graphDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Graphdigest",
      "type": "string"
    },
    "requestDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Requestdigest",
      "type": "string"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/RequirementV1"
      },
      "maxItems": 512,
      "minItems": 1,
      "title": "Requirements",
      "type": "array"
    },
    "schemaVersion": {
      "const": "requirement-graph/v1",
      "title": "Schemaversion",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "requestDigest",
    "requirements",
    "graphDigest"
  ],
  "title": "RequirementGraphV1",
  "type": "object"
}
