{
  "$id": "urn:presenton:authored-vnext:deck-ir:design-grammar-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artDirectionRegistryDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Artdirectionregistrydigest",
      "type": "string"
    },
    "candidatePolicyDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidatepolicydigest",
      "type": "string"
    },
    "canonicalizationPolicy": {
      "const": "canonical-json-unicode-nfc-f64-v1",
      "title": "Canonicalizationpolicy",
      "type": "string"
    },
    "capacityPolicyDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Capacitypolicydigest",
      "type": "string"
    },
    "compilerCompatibility": {
      "items": {
        "const": "constraint-compiler/v1",
        "type": "string"
      },
      "minItems": 1,
      "title": "Compilercompatibility",
      "type": "array"
    },
    "componentRegistryDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Componentregistrydigest",
      "type": "string"
    },
    "deprecatedCapabilities": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "title": "Deprecatedcapabilities",
      "type": "array"
    },
    "fontPolicyDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Fontpolicydigest",
      "type": "string"
    },
    "grammarId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Grammarid",
      "type": "string"
    },
    "layoutRegistryDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Layoutregistrydigest",
      "type": "string"
    },
    "manifestDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifestdigest",
      "type": "string"
    },
    "rendererAbiVersion": {
      "const": "design-component-renderer/v1",
      "title": "Rendererabiversion",
      "type": "string"
    },
    "schemaVersion": {
      "const": "design-grammar-manifest/v1",
      "title": "Schemaversion",
      "type": "string"
    },
    "solverAbiVersion": {
      "const": "constraint-solver/v1",
      "title": "Solverabiversion",
      "type": "string"
    },
    "tokensDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Tokensdigest",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "grammarId",
    "version",
    "tokensDigest",
    "layoutRegistryDigest",
    "componentRegistryDigest",
    "artDirectionRegistryDigest",
    "candidatePolicyDigest",
    "fontPolicyDigest",
    "capacityPolicyDigest",
    "rendererAbiVersion",
    "solverAbiVersion",
    "canonicalizationPolicy",
    "compilerCompatibility",
    "manifestDigest"
  ],
  "title": "DesignGrammarManifestV1",
  "type": "object"
}
