{
  "$id": "urn:presenton:authored-vnext:deck-ir:generation-intent-lineage.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compileReceiptDigest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compilereceiptdigest"
    },
    "editCommandReceiptDigest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Editcommandreceiptdigest"
    },
    "generationIntentDigest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generationintentdigest"
    },
    "intentConsistencyState": {
      "enum": [
        "exact",
        "derived-by-command",
        "origin-only",
        "invalidated"
      ],
      "title": "Intentconsistencystate",
      "type": "string"
    },
    "originGenerationIntentDigest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Origingenerationintentdigest"
    },
    "parentBundleDigest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parentbundledigest"
    },
    "schemaVersion": {
      "const": "generation-intent-lineage/v1",
      "title": "Schemaversion",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "intentConsistencyState"
  ],
  "title": "GenerationIntentLineageV1",
  "type": "object"
}
