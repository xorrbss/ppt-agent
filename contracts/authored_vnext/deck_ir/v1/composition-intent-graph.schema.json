      "type": "string"
    },
    "readingOrder": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Readingorder",
      "type": "array"
    },
    "relations": {
