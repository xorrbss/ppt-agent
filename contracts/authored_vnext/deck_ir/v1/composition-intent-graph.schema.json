      },
      "maxItems": 128,
      "title": "Relations",
      "type": "array"
    },
    "schemaVersion": {
      "const": "composition-intent-graph/v1",
      "title": "Schemaversion",
      "type": "string"
    },
    "slideKey": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
