{
  "$defs": {
    "AbsoluteFloorsV1": {
      "additionalProperties": false,
      "properties": {
        "overallExpertMeanLowerBound": {
          "maximum": 5,
          "minimum": 4,
          "title": "Overallexpertmeanlowerbound",
          "type": "number"
        },
        "p0Maximum": {
          "const": 0,
          "title": "P0Maximum",
          "type": "integer"
        },
        "p1Maximum": {
          "const": 0,
          "title": "P1Maximum",
          "type": "integer"
        },
        "requiredDimensionMeanLowerBound": {
          "maximum": 5,
          "minimum": 3.75,
          "title": "Requireddimensionmeanlowerbound",
          "type": "number"
        },
        "worstDecileMeanLowerBound": {
          "maximum": 5,
          "minimum": 3.5,
          "title": "Worstdecilemeanlowerbound",
          "type": "number"
        }
      },
      "required": [
        "overallExpertMeanLowerBound",
        "requiredDimensionMeanLowerBound",
        "worstDecileMeanLowerBound",
        "p0Maximum",
        "p1Maximum"
      ],
      "title": "AbsoluteFloorsV1",
      "type": "object"
    },
    "PairwisePreferenceV1": {
      "additionalProperties": false,
      "properties": {
        "candidatePreferredOrTiedPointMinimum": {
          "maximum": 1,
          "minimum": 0.9,
          "title": "Candidatepreferredortiedpointminimum",
          "type": "number"
        },
        "oneSided95LowerBoundMinimum": {
          "maximum": 1,
          "minimum": 0.85,
          "title": "Onesided95Lowerboundminimum",
          "type": "number"
        }
      },
      "required": [
        "candidatePreferredOrTiedPointMinimum",
        "oneSided95LowerBoundMinimum"
      ],
      "title": "PairwisePreferenceV1",
      "type": "object"
    },
    "PowerAnalysisV1": {
      "additionalProperties": false,
      "properties": {
        "minimumOverallPairs": {
          "minimum": 120,
          "title": "Minimumoverallpairs",
          "type": "integer"
        },
        "minimumPairsPerRequiredMarginalStratum": {
          "minimum": 30,
          "title": "Minimumpairsperrequiredmarginalstratum",
          "type": "integer"
        },
        "nonInferiorityMargin": {
          "const": 0.25,
          "title": "Noninferioritymargin",
          "type": "number"
        },
        "oneSidedAlpha": {
          "const": 0.025,
          "title": "Onesidedalpha",
          "type": "number"
        },
        "targetPower": {
          "const": 0.8,
          "title": "Targetpower",
          "type": "number"
        }
      },
      "required": [
        "oneSidedAlpha",
        "targetPower",
        "nonInferiorityMargin",
        "minimumOverallPairs",
        "minimumPairsPerRequiredMarginalStratum"
      ],
      "title": "PowerAnalysisV1",
      "type": "object"
    },
    "ReliabilityV1": {
      "additionalProperties": false,
      "properties": {
        "belowMinimumAction": {
          "const": "evaluation-invalid-recalibrate",
          "title": "Belowminimumaction",
          "type": "string"
        },
        "metric": {
          "const": "krippendorff-alpha-ordinal",
          "title": "Metric",
          "type": "string"
        },
        "minimum": {
          "maximum": 1,
          "minimum": 0.67,
          "title": "Minimum",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "minimum",
        "belowMinimumAction"
      ],
      "title": "ReliabilityV1",
      "type": "object"
    },
    "ReviewProtocolV1": {
      "additionalProperties": false,
      "properties": {
        "calibrationRequired": {
          "const": true,
          "title": "Calibrationrequired",
          "type": "boolean"
        },
        "pathRcAndFilenameBlinded": {
          "const": true,
          "title": "Pathrcandfilenameblinded",
          "type": "boolean"
        },
        "ratingScale": {
          "const": "1..5",
          "title": "Ratingscale",
          "type": "string"
        },
        "reviewersPerPair": {
          "minimum": 3,
          "title": "Reviewersperpair",
          "type": "integer"
        },
        "tieHandling": {
          "const": "explicit-tie",
          "title": "Tiehandling",
          "type": "string"
        }
      },
      "required": [
        "reviewersPerPair",
        "ratingScale",
        "calibrationRequired",
        "pathRcAndFilenameBlinded",
        "tieHandling"
      ],
      "title": "ReviewProtocolV1",
      "type": "object"
    }
  },
  "$id": "urn:presenton:authored-vnext:deck-ir:visual-quality-evaluation-policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "absoluteFloors": {
      "$ref": "#/$defs/AbsoluteFloorsV1"
    },
    "confidenceMethod": {
      "const": "stratified-bootstrap-one-sided-95-v1",
      "title": "Confidencemethod",
      "type": "string"
    },
    "corpusDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Corpusdigest",
      "type": "string"
    },
    "multiplicityCorrection": {
      "const": "holm-v1",
      "title": "Multiplicitycorrection",
      "type": "string"
    },
    "pairwisePreference": {
      "$ref": "#/$defs/PairwisePreferenceV1"
    },
    "policyDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policydigest",
      "type": "string"
    },
    "powerAnalysis": {
      "$ref": "#/$defs/PowerAnalysisV1"
    },
    "reliability": {
      "$ref": "#/$defs/ReliabilityV1"
    },
    "reviewProtocol": {
      "$ref": "#/$defs/ReviewProtocolV1"
    },
    "schemaVersion": {
      "const": "visual-quality-evaluation-policy/v1",
      "title": "Schemaversion",
      "type": "string"
    },
    "sealedHoldoutDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Sealedholdoutdigest",
      "type": "string"
    },
    "studyDesign": {
      "const": "paired-stratified-blind",
      "title": "Studydesign",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "corpusDigest",
    "sealedHoldoutDigest",
    "studyDesign",
    "powerAnalysis",
    "reviewProtocol",
    "absoluteFloors",
    "pairwisePreference",
    "reliability",
    "confidenceMethod",
    "multiplicityCorrection",
    "policyDigest"
  ],
  "title": "VisualQualityEvaluationPolicyV1",
  "type": "object"
}
