{
  "$defs": {
    "ArtIntentResolutionReceiptV1": {
      "additionalProperties": false,
      "properties": {
        "compositionDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Compositiondigest",
          "type": "string"
        },
        "contentPreserved": {
          "const": true,
          "title": "Contentpreserved",
          "type": "boolean"
        },
        "grammarDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Grammardigest",
          "type": "string"
        },
        "layoutId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$",
          "title": "Layoutid",
          "type": "string"
        },
        "pairDecisions": {
          "items": {
            "$ref": "#/$defs/OverlapPairDecisionV1"
          },
          "maxItems": 16,
          "title": "Pairdecisions",
          "type": "array"
        },
        "providerCallsAdded": {
          "const": 0,
          "title": "Providercallsadded",
          "type": "integer"
        },
        "providerIntentDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Providerintentdigest",
          "type": "string"
        },
        "receiptDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Receiptdigest",
          "type": "string"
        },
        "resolvedIntentDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Resolvedintentdigest",
          "type": "string"
        },
        "schemaVersion": {
          "const": "art-intent-resolution-receipt/v1",
          "title": "Schemaversion",
          "type": "string"
        },
        "slideDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Slidedigest",
          "type": "string"
        },
        "slideKey": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Slidekey",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "slideKey",
        "providerIntentDigest",
        "resolvedIntentDigest",
        "slideDigest",
        "compositionDigest",
        "grammarDigest",
        "layoutId",
        "pairDecisions",
        "contentPreserved",
        "providerCallsAdded",
        "receiptDigest"
      ],
      "title": "ArtIntentResolutionReceiptV1",
      "type": "object"
    },
    "LocalCandidateV2": {
      "additionalProperties": false,
      "properties": {
        "candidateDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidatedigest",
          "type": "string"
        },
        "candidateId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Candidateid",
          "type": "string"
        },
        "diversitySignature": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Diversitysignature",
          "type": "string"
        },
        "hardConstraintStatus": {
          "enum": [
            "passed",
            "failed"
          ],
          "title": "Hardconstraintstatus",
          "type": "string"
        },
        "layoutId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$",
          "title": "Layoutid",
          "type": "string"
        },
        "qualityVector": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "propertyNames": {
            "enum": [
              "hierarchy",
              "whitespace",
              "roleFitness",
              "artDirection"
            ]
          },
          "title": "Qualityvector",
          "type": "object"
        },
        "rank": {
          "maximum": 8,
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "resolutionReceipt": {
          "$ref": "#/$defs/ArtIntentResolutionReceiptV1"
        },
        "slideKey": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Slidekey",
          "type": "string"
        },
        "variantId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Variantid",
          "type": "string"
        }
      },
      "required": [
        "candidateId",
        "slideKey",
        "layoutId",
        "variantId",
        "hardConstraintStatus",
        "qualityVector",
        "diversitySignature",
        "candidateDigest",
        "rank",
        "resolutionReceipt"
      ],
      "title": "LocalCandidateV2",
      "type": "object"
    },
    "LocalDeckSelectionV2": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "pareto-beam-v1",
          "title": "Algorithm",
          "type": "string"
        },
        "beamWidth": {
          "maximum": 8,
          "minimum": 1,
          "title": "Beamwidth",
          "type": "integer"
        },
        "selectedCombinationDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Selectedcombinationdigest",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "beamWidth",
        "selectedCombinationDigest"
      ],
      "title": "LocalDeckSelectionV2",
      "type": "object"
    },
    "LocalSlideSelectionV2": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/LocalCandidateV2"
          },
          "maxItems": 8,
          "minItems": 4,
          "title": "Candidates",
          "type": "array"
        },
        "enumeratedCount": {
          "maximum": 8,
          "minimum": 4,
          "title": "Enumeratedcount",
          "type": "integer"
        },
        "feasibleCount": {
          "maximum": 8,
          "minimum": 1,
          "title": "Feasiblecount",
          "type": "integer"
        },
        "requestedK": {
          "maximum": 8,
          "minimum": 4,
          "title": "Requestedk",
          "type": "integer"
        },
        "selectedCandidateId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Selectedcandidateid",
          "type": "string"
        },
        "slideKey": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Slidekey",
          "type": "string"
        }
      },
      "required": [
        "slideKey",
        "requestedK",
        "enumeratedCount",
        "feasibleCount",
        "candidates",
        "selectedCandidateId"
      ],
      "title": "LocalSlideSelectionV2",
      "type": "object"
    },
    "OverlapPairDecisionV1": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "const": "separate",
          "title": "Decision",
          "type": "string"
        },
        "reason": {
          "enum": [
            "exclusive_content_overlap_forbidden",
            "compiler_owned_overlay_evidence_unavailable"
          ],
          "title": "Reason",
          "type": "string"
        },
        "zonePair": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "type": "string"
            }
          ],
          "title": "Zonepair",
          "type": "array"
        }
      },
      "required": [
        "zonePair",
        "decision",
        "reason"
      ],
      "title": "OverlapPairDecisionV1",
      "type": "object"
    }
  },
  "$id": "urn:presenton:authored-vnext:deck-ir:v2:candidate-set-selection-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidatePolicyDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidatepolicydigest",
      "type": "string"
    },
    "compilerVersion": {
      "const": "constraint-compiler/v1",
      "title": "Compilerversion",
      "type": "string"
    },
    "deckSelection": {
      "$ref": "#/$defs/LocalDeckSelectionV2"
    },
    "grammarDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Grammardigest",
      "type": "string"
    },
    "initialSelectionReceiptDigest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initialselectionreceiptdigest"
    },
    "providerCallsAdded": {
      "const": 0,
      "title": "Providercallsadded",
      "type": "integer"
    },
    "receiptDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Receiptdigest",
      "type": "string"
    },
    "schemaVersion": {
      "const": "candidate-set-selection-receipt/v2",
      "title": "Schemaversion",
      "type": "string"
    },
    "slides": {
      "items": {
        "$ref": "#/$defs/LocalSlideSelectionV2"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Slides",
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "grammarDigest",
    "compilerVersion",
    "candidatePolicyDigest",
    "slides",
    "deckSelection",
    "providerCallsAdded",
    "receiptDigest"
  ],
  "title": "CandidateSetSelectionReceiptV2",
  "type": "object"
}
