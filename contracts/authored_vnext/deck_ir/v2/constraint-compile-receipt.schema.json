{
  "$defs": {
    "ArtIntentResolutionReceiptV1": {
      "additionalProperties": false,
      "properties": {
        "compositionDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Compositiondigest",
          "type": "string"
        },
        "contentPreserved": {
          "const": true,
          "title": "Contentpreserved",
          "type": "boolean"
        },
        "grammarDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Grammardigest",
          "type": "string"
        },
        "layoutId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$",
          "title": "Layoutid",
          "type": "string"
        },
        "pairDecisions": {
          "items": {
            "$ref": "#/$defs/OverlapPairDecisionV1"
          },
          "maxItems": 16,
          "title": "Pairdecisions",
          "type": "array"
        },
        "providerCallsAdded": {
          "const": 0,
          "title": "Providercallsadded",
          "type": "integer"
        },
        "providerIntentDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Providerintentdigest",
          "type": "string"
        },
        "receiptDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Receiptdigest",
          "type": "string"
        },
        "resolvedIntentDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Resolvedintentdigest",
          "type": "string"
        },
        "schemaVersion": {
          "const": "art-intent-resolution-receipt/v1",
          "title": "Schemaversion",
          "type": "string"
        },
        "slideDigest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Slidedigest",
          "type": "string"
        },
        "slideKey": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Slidekey",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "slideKey",
        "providerIntentDigest",
        "resolvedIntentDigest",
        "slideDigest",
        "compositionDigest",
        "grammarDigest",
        "layoutId",
        "pairDecisions",
        "contentPreserved",
        "providerCallsAdded",
        "receiptDigest"
      ],
      "title": "ArtIntentResolutionReceiptV1",
      "type": "object"
    },
    "CompositionRelationV1": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "From",
          "type": "string"
        },
        "relation": {
          "enum": [
            "leftOf",
            "rightOf",
            "above",
            "below",
            "alignTop",
            "alignCenter",
            "equalWidth",
            "emphasis",
            "flow"
          ],
          "title": "Relation",
          "type": "string"
        },
        "strength": {
          "enum": [
            "hard",
            "soft"
          ],
          "title": "Strength",
          "type": "string"
        },
        "to": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "relation",
        "to",
        "strength"
      ],
      "title": "CompositionRelationV1",
      "type": "object"
    },
    "ConnectorContractV2": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "right",
            "left",
            "up",
            "down"
          ],
          "title": "Direction",
          "type": "string"
        },
        "fromQid": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Fromqid",
          "type": "string"
        },
        "qid": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Qid",
          "type": "string"
        },
        "toQid": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Toqid",
          "type": "string"
        }
      },
      "required": [
        "qid",
        "fromQid",
        "toQid",
        "direction"
      ],
      "title": "ConnectorContractV2",
      "type": "object"
    },
    "OverlapPairDecisionV1": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "const": "separate",
          "title": "Decision",
          "type": "string"
        },
        "reason": {
          "enum": [
            "exclusive_content_overlap_forbidden",
            "compiler_owned_overlay_evidence_unavailable"
          ],
          "title": "Reason",
          "type": "string"
        },
        "zonePair": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "type": "string"
            },
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
              "type": "string"
            }
          ],
          "title": "Zonepair",
          "type": "array"
        }
      },
      "required": [
        "zonePair",
        "decision",
        "reason"
      ],
      "title": "OverlapPairDecisionV1",
      "type": "object"
    },
    "ZoneContractV2": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "enum": [
            "exclusive-content",
            "overlay-host/backplate",
            "annotation",
            "ambient"
          ],
          "title": "Capability",
          "type": "string"
        },
        "contentQids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Contentqids",
          "type": "array"
        },
        "maximumColumnSpan": {
          "maximum": 24,
          "minimum": 1,
          "title": "Maximumcolumnspan",
          "type": "integer"
        },
        "minimumColumnSpan": {
          "maximum": 24,
          "minimum": 1,
          "title": "Minimumcolumnspan",
          "type": "integer"
        },
        "qid": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Qid",
          "type": "string"
        },
        "zoneKey": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "title": "Zonekey",
          "type": "string"
        }
      },
      "required": [
        "zoneKey",
        "qid",
        "contentQids",
        "minimumColumnSpan",
        "maximumColumnSpan",
        "capability"
      ],
      "title": "ZoneContractV2",
      "type": "object"
    }
  },
  "$id": "urn:presenton:authored-vnext:deck-ir:v2:constraint-compile-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artDirectionIntentDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Artdirectionintentdigest",
      "type": "string"
    },
    "browserMeasurementDigest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Browsermeasurementdigest"
    },
    "candidateId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Candidateid",
      "type": "string"
    },
    "candidateSelectionReceiptDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidateselectionreceiptdigest",
      "type": "string"
    },
    "chosenLayoutId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$",
      "title": "Chosenlayoutid",
      "type": "string"
    },
    "compilerVersion": {
      "const": "constraint-compiler/v1",
      "title": "Compilerversion",
      "type": "string"
    },
    "compositionIntentGraphDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Compositionintentgraphdigest",
      "type": "string"
    },
    "compositionRelations": {
      "items": {
        "$ref": "#/$defs/CompositionRelationV1"
      },
      "maxItems": 128,
      "title": "Compositionrelations",
      "type": "array"
    },
    "connectorContracts": {
      "items": {
        "$ref": "#/$defs/ConnectorContractV2"
      },
      "maxItems": 12,
      "title": "Connectorcontracts",
      "type": "array"
    },
    "contentTextDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Contenttextdigest",
      "type": "string"
    },
    "deckIrDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Deckirdigest",
      "type": "string"
    },
    "grammarDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Grammardigest",
      "type": "string"
    },
    "hardConstraintStatus": {
      "enum": [
        "passed",
        "failed"
      ],
      "title": "Hardconstraintstatus",
      "type": "string"
    },
    "htmlDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Htmldigest",
      "type": "string"
    },
    "initialCandidateSelectionReceiptDigest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initialcandidateselectionreceiptdigest"
    },
    "intentResolutionReceipt": {
      "$ref": "#/$defs/ArtIntentResolutionReceiptV1"
    },
    "measurementClosureRevision": {
      "maximum": 2,
      "minimum": 0,
      "title": "Measurementclosurerevision",
      "type": "integer"
    },
    "operationId": {
      "format": "uuid",
      "title": "Operationid",
      "type": "string"
    },
    "providerIntentDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Providerintentdigest",
      "type": "string"
    },
    "qidRegistryDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Qidregistrydigest",
      "type": "string"
    },
    "receiptDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Receiptdigest",
      "type": "string"
    },
    "recoverySteps": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
        "type": "string"
      },
      "maxItems": 8,
      "title": "Recoverysteps",
      "type": "array"
    },
    "resolvedIntentDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Resolvedintentdigest",
      "type": "string"
    },
    "schemaVersion": {
      "const": "constraint-compile-receipt/v2",
      "title": "Schemaversion",
      "type": "string"
    },
    "semanticDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Semanticdigest",
      "type": "string"
    },
    "slideIrDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Slideirdigest",
      "type": "string"
    },
    "slideKey": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "title": "Slidekey",
      "type": "string"
    },
    "softScore": {
      "title": "Softscore",
      "type": "number"
    },
    "strategyDecisionDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Strategydecisiondigest",
      "type": "string"
    },
    "zoneContracts": {
      "items": {
        "$ref": "#/$defs/ZoneContractV2"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Zonecontracts",
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "operationId",
    "slideKey",
    "strategyDecisionDigest",
    "deckIrDigest",
    "slideIrDigest",
    "compositionIntentGraphDigest",
    "artDirectionIntentDigest",
    "candidateSelectionReceiptDigest",
    "grammarDigest",
    "compilerVersion",
    "chosenLayoutId",
    "qidRegistryDigest",
    "htmlDigest",
    "semanticDigest",
    "hardConstraintStatus",
    "softScore",
    "measurementClosureRevision",
    "browserMeasurementDigest",
    "receiptDigest",
    "candidateId",
    "providerIntentDigest",
    "resolvedIntentDigest",
    "intentResolutionReceipt",
    "zoneContracts",
    "compositionRelations",
    "contentTextDigest"
  ],
  "title": "ConstraintCompileReceiptV2",
  "type": "object"
}
