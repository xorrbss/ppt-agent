{
  "$defs": {
    "AIEditZone": {
      "additionalProperties": false,
      "description": "Authored-template composition envelope with optional AI intent.\n\nHistorical contracts persisted only ``id``, ``scope`` and ``bounds``.  All\nauthoring fields therefore remain optional and are omitted again when they\nwere absent, so those immutable revisions retain their geometry-only wire\nrepresentation.",
      "properties": {
        "bounds": {
          "$ref": "#/$defs/Rect"
        },
        "contentType": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "text",
                "cards",
                "list",
                "table",
                "chart",
                "mixed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contenttype"
        },
        "density": {
          "anyOf": [
            {
              "enum": [
                "sparse",
                "balanced",
                "dense"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Density"
        },
        "emptyBehavior": {
          "anyOf": [
            {
              "enum": [
                "hidden",
                "blank",
                "fallback"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Emptybehavior"
        },
        "fallbackText": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallbacktext"
        },
        "id": {
          "pattern": "^ai-zone:[a-z0-9][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "instruction": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instruction"
        },
        "maxChars": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxchars"
        },
        "maxItems": {
          "anyOf": [
            {
              "maximum": 24,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxitems"
        },
        "pattern": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "numberedCards",
                "bulletList",
                "comparisonTable",
                "metricChart",
                "iconCards"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommonElementScope"
            },
            {
              "$ref": "#/$defs/LayoutElementScope"
            }
          ],
          "title": "Scope"
        },
        "sourcePolicy": {
          "anyOf": [
            {
              "enum": [
                "documentOnly",
                "promptAndDocument",
                "promptOnly"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourcepolicy"
        },
        "stylePolicy": {
          "anyOf": [
            {
              "const": "inheritTemplate",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stylepolicy"
        },
        "textAlign": {
          "anyOf": [
            {
              "enum": [
                "left",
                "center",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Textalign"
        }
      },
      "required": [
        "id",
        "scope",
        "bounds"
      ],
      "title": "AIEditZone",
      "type": "object"
    },
